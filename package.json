  "scripts": {
    "test": "node --test tests/cli.test.cjs tests/context-recovery-policy.test.cjs tests/stack-migration-policy.test.cjs tests/usage.test.cjs tests/opencode-plugin.test.cjs tests/packlist.test.cjs",
